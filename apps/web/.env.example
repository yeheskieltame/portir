NEXT_PUBLIC_CHAIN=testnet
NEXT_PUBLIC_PLAN_REGISTRY=
NEXT_PUBLIC_EXECUTOR=
NEXT_PUBLIC_RPC_URL=
# Binance Web3 API (web3.binance.com developer portal). Server-side only: never prefix with NEXT_PUBLIC_.
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=

# Testnet mode: signs TestExchange quotes (EIP-712) with the live mainnet price. Throwaway testnet key whose address is the exchange keeper.
TESTNET_KEEPER_KEY=

# The Portir agent (BNB Agent Studio) for the in-app "Ask the agent" chat; local `bag dev` by default.
PORTIR_AGENT_URL=http://127.0.0.1:9000

# Where the wordmark in the header links to (the landing page).
NEXT_PUBLIC_LANDING_URL=https://portir.xyz
