{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Portir",
  "description": "US stocks on BNB Chain, bought at a fair price. Plans, Loan Guard and an agent on BNB Agent Studio.",
  "colors": {
    "primary": "#3B82D6",
    "light": "#61A6F6",
    "dark": "#2563B0"
  },
  "logo": {
    "light": "/logo/mark-black.svg",
    "dark": "/logo/mark-white.svg",
    "href": "https://portir.xyz"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "navbar": {
